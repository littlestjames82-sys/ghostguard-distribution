{"rules":[{"effect":"deny","id":"no-spend-ever","locked":true,"note":"Locked team layer: no spend, ever.","when":"permission_class == 'SPEND'"},{"effect":"deny","id":"no-delete-ever","locked":true,"note":"Locked team layer: no deletes, ever.","when":"permission_class == 'DELETE'"},{"effect":"hand_off","handoff_to":"owner","id":"comms-to-strangers-handoff","when":"permission_class == 'COMMUNICATE' && payload.recipient_known == false"},{"effect":"ask","id":"deploys-ask","when":"permission_class == 'DEPLOY'"},{"effect":"ask","id":"publish-ask","when":"permission_class == 'PUBLISH'"},{"effect":"ask","id":"network-write-ask-unapproved","when":"permission_class == 'NETWORK_WRITE' && !approved"},{"effect":"allow","id":"reads-and-local-writes-allow","when":"permission_class == 'READ' || permission_class == 'WRITE_LOCAL'"},{"effect":"allow","id":"execute-allow","when":"permission_class == 'EXECUTE'"}]}